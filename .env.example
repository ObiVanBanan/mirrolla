# OpenAI API key (https://platform.openai.com/api-keys)
# Используется Router, Planner, Reporter и openai_ci только при EXECUTION_BACKEND=openai_ci
token=sk-...

# Execution backend
# local_qwen = локальный Qwen через vLLM + Docker sandbox
# openai_ci  = резервный hosted OpenAI Code Interpreter
EXECUTION_BACKEND=local_qwen

# Local vLLM endpoint
LOCAL_LLM_BASE_URL=http://127.0.0.1:8010/v1
LOCAL_LLM_API_KEY=mirrolla-local
LOCAL_LLM_MODEL=qwen-coder-local
LOCAL_LLM_TIMEOUT_SECONDS=180
LOCAL_LLM_MAX_TOKENS=2500
LOCAL_LLM_TEMPERATURE=0.1
LOCAL_LLM_MAX_PROMPT_CHARS=22000

# Local Docker sandbox
LOCAL_SANDBOX_IMAGE=mirrolla-analysis-sandbox:py312
LOCAL_SANDBOX_TIMEOUT_SECONDS=180
LOCAL_SANDBOX_MEMORY=4g
LOCAL_SANDBOX_CPUS=2
LOCAL_SANDBOX_PIDS_LIMIT=128
LOCAL_SANDBOX_ROOT=.runtime/local-executor
LOCAL_SANDBOX_KEEP_RUNS=0

# Опционально: URL API для авто-отчёта (reports/generator.py)
# По умолчанию: http://127.0.0.1:8000/api/v1
# MIRROLLA_API=http://127.0.0.1:8000/api/v1

# Модели (опционально, есть дефолты)
# ROUTER_MODEL=gpt-4o-mini
# PLANNER_MODEL=gpt-4o
# EXECUTOR_MODEL=gpt-4o-mini
# REPORTER_MODEL=gpt-4o

# Доступ к 1С (для pre-fetch balances)
# ONE_C_URL=http://192.168.201.250/Sklad_Server/hs/WebAssistant
# ONE_C_USER=WebAssistant
# ONE_C_PASS=WebAssistant

# API ключ для защиты POST эндпоинтов (пусто = auth отключена, dev mode)
# API_KEY=

# CORS: через запятую, '*' разрешает все (но отключает credentials)
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
